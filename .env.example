# Contact form delivery (src/app/api/contact/route.ts).
# Without these the form returns a clear "not connected" message instead of
# silently dropping enquiries.

# API key from https://resend.com
RESEND_API_KEY=

# A verified sender on your Resend domain.
# e.g. "Grow In Product <hello@growinproduct.com>"
CONTACT_FROM=
